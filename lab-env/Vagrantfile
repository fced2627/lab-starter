# -*- mode: ruby -*-
# FCED 2026/2027 — teaching cluster on your own laptop.
#
#   vagrant up                 bring up mgmt + store (+ nodes, while they are still boxes)
#   vagrant ssh mgmt           get a shell on the management node
#   vagrant halt / destroy     stop / delete
#
# Two networks per machine (interface names depend on the provider: enp0s8/enp0s9
# on VirtualBox, eth0/eth1 or ens*/enp* elsewhere — find the cluster one by address):
#   1st  NAT, created by Vagrant. Host-to-VM SSH and outbound internet only.
#   2nd  the cluster network 10.10.G.0/24, with the hypervisor's DHCP DISABLED
#        so that Warewulf's dhcpd can own it from Module 04 onwards.
#
# Host architecture matters (see README §2): on an ARM host (Apple Silicon) the
# guests are aarch64, nested virtualisation is off, and the default box changes.
#
# Apple Silicon has two providers. VirtualBox (the default) is enough for Modules
# 01-03. The QEMU provider is the one that can PXE-boot diskless nodes (Module 04):
#   vagrant plugin install vagrant-qemu && ./qemu/make-box.sh   # once
#   vagrant up --provider qemu
# Its cluster network is a VDE switch (vde_switch, shipped with Homebrew's QEMU)
# at /tmp/fced-gNN.vde, started by this file; no root is needed.
#
# From Module 04, node01 and node02 stop being Vagrant boxes: you destroy them
# here and recreate them as diskless PXE machines with lab-env/nodes-pxe.sh.
# Until then they are ordinary boxes so that Modules 01-03 work immediately.

GROUP   = ENV.fetch("FCED_GROUP", "07").rjust(2, "0")
SUBNET  = "10.10.#{GROUP.to_i}"
# ARM hosts: the official rockylinux/9 arm64 box describes an x86 machine in its
# OVF and VirtualBox refuses to start it; Bento's arm64 box is correct.
HOST_ARM = RbConfig::CONFIG["host_cpu"] =~ /arm|aarch64/ ? true : false
BOX     = ENV.fetch("FCED_BOX", HOST_ARM ? "bento/rockylinux-9" : "rockylinux/9")
PROFILE = ENV.fetch("FCED_PROFILE", "full")      # full = 4 VMs, small = 3 VMs

# memory (MB) / vCPU.  full: 8 GB and 7 vCPU in total — sized for a 16 GB laptop.
SPEC = {
  "mgmt"   => { mem: 3072, cpus: 2, ip: "#{SUBNET}.1"   },
  "store"  => { mem: 1024, cpus: 1, ip: "#{SUBNET}.20"  },
  "node01" => { mem: 2048, cpus: 2, ip: "#{SUBNET}.101" },
  "node02" => { mem: 2048, cpus: 2, ip: "#{SUBNET}.102" },
}
MACHINES = PROFILE == "small" ? %w[mgmt store node01] : %w[mgmt store node01 node02]

# QEMU provider only: the VDE switch that is the cluster network, a fixed SSH port
# per machine, and a fixed MAC on the cluster NIC (52:54:00:fc:GG:<last octet>).
# The ports sit below the ephemeral range (macOS 49152+, Linux 32768+): up there the
# OS may already have lent the port to an outgoing connection, and `vagrant up`
# fails at random with "Could not set up host forwarding rule".
VDE_SOCK  = "/tmp/fced-g#{GROUP}.vde"
QEMU_PORT = { "mgmt" => 20022, "store" => 20023, "node01" => 20024, "node02" => 20025 }
def qemu_mac(ip) = format("52:54:00:fc:%02x:%02x", GROUP.to_i, ip.split(".").last.to_i)

def vde_switch_up
  pidfile = "#{VDE_SOCK}.pid"
  pid = File.read(pidfile).to_i rescue 0
  return if pid > 0 && (Process.kill(0, pid) rescue false)
  system("vde_switch", "-s", VDE_SOCK, "-d", "-p", pidfile) or
    abort "could not start vde_switch (brew install qemu provides it)"
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false
  # Keep Vagrant's own key working: Module 02 hardens sshd, and locking yourself
  # out of your own laptop VMs is a bad way to spend an afternoon.
  config.ssh.insert_key = true
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.trigger.before :up do |t|
    t.ruby { |_env, machine| vde_switch_up if machine.provider_name == :qemu }
  end

  MACHINES.each do |name|
    spec = SPEC.fetch(name)

    config.vm.define name do |m|
      m.vm.hostname = "#{name}.g#{GROUP}.hpc.local"

      # --- the cluster network -------------------------------------------------
      m.vm.network "private_network",
        ip: spec[:ip],
        netmask: "255.255.255.0",
        # libvirt: an isolated network with no dnsmasq DHCP
        libvirt__network_name: "fced-g#{GROUP}",
        libvirt__dhcp_enabled: false,
        libvirt__forward_mode: "none",
        # VirtualBox: an internal network, which has no built-in DHCP either
        virtualbox__intnet: "fced-g#{GROUP}"

      # store gets the data disk that becomes /scratch
      if name == "store"
        m.vm.disk :disk, size: "40GB", name: "data"
      end

      m.vm.provider :libvirt do |v|
        v.memory = spec[:mem]
        v.cpus   = spec[:cpus]
        v.cpu_mode = "host-passthrough"       # so lscpu shows real CPU flags
        v.machine_virtual_size = 30
      end

      m.vm.provider :virtualbox do |v|
        v.memory = spec[:mem]
        v.cpus   = spec[:cpus]
        # On Apple Silicon this enables EL2 and the vCPU dies with a Guru
        # Meditation before the firmware runs: x86 hosts only.
        v.customize ["modifyvm", :id, "--nested-hw-virt", "on"] unless HOST_ARM
        v.customize ["modifyvm", :id, "--paravirtprovider", "kvm"]
      end

      # Apple Silicon, whole cluster in QEMU (see the header). vagrant-qemu ignores
      # private_network, so the cluster NIC is added here and configured below.
      m.vm.provider :qemu do |v, override|
        override.vm.box = ENV.fetch("FCED_BOX", "fced/rockylinux-9-qemu")
        v.memory   = "#{spec[:mem]}M"
        v.smp      = spec[:cpus]
        v.ssh_port = QEMU_PORT.fetch(name)
        # NAT NIC in PCI slot 8 and cluster NIC in slot 9: the guest names them
        # enp0s8/enp0s9, as on VirtualBox, and the image's network profile matches.
        v.net_device = "virtio-net-pci,addr=0x8"
        # Disks on virtio-scsi: the image's initramfs was built for it.
        v.drive_interface = "none"
        args = ["-device", "virtio-scsi-pci,id=scsi0,addr=0x5",
                "-device", "scsi-hd,bus=scsi0.0,drive=disk0,bootindex=0"]
        args += ["-device", "scsi-hd,bus=scsi0.0,drive=disk1"] if name == "store"
        args += ["-netdev", "vde,id=cluster,sock=#{VDE_SOCK}",
                 "-device", "virtio-net-pci,netdev=cluster,mac=#{qemu_mac(spec[:ip])},addr=0x9"]
        v.extra_qemu_args = args
        override.vm.provision "cluster-network", type: "shell", inline: <<-SHELL
          set -e
          nmcli -t -f NAME con show | grep -qx fced-cluster ||
            nmcli con add type ethernet ifname enp0s9 con-name fced-cluster \
              ipv4.method manual ipv4.addresses #{spec[:ip]}/24 ipv6.method ignore
          nmcli con up fced-cluster >/dev/null
        SHELL
      end

      # Minimal bootstrap only. Everything else is your Ansible, from Module 05.
      m.vm.provision "shell", inline: <<-SHELL
        set -e
        cat >> /etc/hosts <<'HOSTS'
#{SPEC.map { |n, s| "#{s[:ip]}  #{n}.g#{GROUP}.hpc.local #{n}" }.join("\n")}
HOSTS
        command -v python3 >/dev/null || dnf -y install python3
        systemctl disable --now firewalld 2>/dev/null || true
        # The box ships ONE set of SSH host keys, baked in when it was built: every
        # VM made from it, on every laptop, would share the same private host key.
        # Give this machine its own, once.
        if [ ! -e /etc/ssh/.fced-host-keys ]; then
          rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
          ssh-keygen -A >/dev/null
          systemctl restart sshd
          touch /etc/ssh/.fced-host-keys
        fi
      SHELL
    end
  end
end
